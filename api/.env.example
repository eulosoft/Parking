NODE_ENV=development
PORT=4000
STORAGE_DRIVER=sqlite
JWT_SECRET=
DATABASE_PATH=./parking.db
CORS_ORIGINS=
ADMIN_NAME=Parking Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternatively, use workload identity / Application Default Credentials.
# Or configure all three environment variables below:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
REMINDER_INTERVAL_MS=3600000
# Required for STORAGE_DRIVER=firestore (including Vercel production).
# Configure either a service-account file outside the repository,
# GOOGLE_APPLICATION_CREDENTIALS (ADC), or all three FIREBASE_* values below.
